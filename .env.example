# Variables de entorno de WHEELS. Copie este archivo como .env y cambie los valores:
#   cp .env.example .env
# El archivo .env nunca se sube al repositorio (está en .gitignore).

# Puerto del equipo donde se publica la API del backend (el contenedor siempre escucha en el 3000).
PUERTO_BACKEND=3000

# Clave con la que la API firma los tokens de sesión. OBLIGATORIA, mínimo 32 caracteres.
# Genere una propia, por ejemplo con:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   openssl rand -hex 32
# Si cambia, todas las sesiones abiertas se cierran (los usuarios vuelven a ingresar).
SECRETO_TOKEN=cambie-esta-clave-por-una-generada-con-openssl

# Imagen que se despliega. En desarrollo se construye localmente (wheels-backend:dev).
# En el despliegue el pipeline la reemplaza por ghcr.io/<usuario-github>/wheels-backend:sha-<commit>.
IMAGEN_BACKEND=wheels-backend:dev
